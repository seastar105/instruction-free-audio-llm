+def evaluate_openended_from_vllm_results(
+    results_path,
+    questions,
+    reference_answers,
+    model_responses,
+    task_types,
+):
+    """Score the complete batched-vLLM result set without dropping failures."""
+    with open(results_path, 'r', encoding='utf-8') as handle:
+        judge_records = [json.loads(line) for line in handle if line.strip()]
+
+    expected = len(questions)
+    if len(judge_records) != expected:
+        raise ValueError(
+            f"Expected {expected} open judge results, found {len(judge_records)}"
+        )
+
+    all_scores = []
+    detailed_evaluations = []
+    for index, (question, ref_answer, model_response, task_type) in enumerate(
+        zip(questions, reference_answers, model_responses, task_types)
+    ):
+        judge_record = judge_records[index]
+        if judge_record.get('open_index') != index:
+            raise ValueError(
+                f"Open judge result index mismatch at {index}: {judge_record.get('open_index')}"
+            )
+        evaluation_text = str(judge_record.get('evaluation') or '')
+        scores = extract_scores_from_evaluation(evaluation_text)
+        all_scores.append(scores)
+        detailed_evaluations.append({
+            'question': question,
+            'reference_answer': ref_answer,
+            'model_response': model_response,
+            'evaluation': evaluation_text,
+            'scores': scores,
+            'task_type': task_type,
+        })
+    return all_scores, detailed_evaluations
